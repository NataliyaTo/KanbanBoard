<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kanban Board</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
      padding: 24px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 12px;
    }

    header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      background: linear-gradient(135deg, #6366f1, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn {
      padding: 8px 16px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s;
    }

    .btn-primary {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: white;
    }
    .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }

    .btn-secondary {
      background: #1e293b;
      color: #94a3b8;
      border: 1px solid #334155;
    }
    .btn-secondary:hover { background: #334155; color: #e2e8f0; }

    .btn-danger {
      background: #ef4444;
      color: white;
    }
    .btn-danger:hover { background: #dc2626; }

    /* Board */
    .board {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      padding-bottom: 16px;
      align-items: flex-start;
    }

    .column {
      background: #1e293b;
      border-radius: 14px;
      min-width: 280px;
      width: 280px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 140px);
      border: 1px solid #334155;
      transition: border-color 0.2s;
    }

    .column.drag-over {
      border-color: #6366f1;
      background: #1e2d45;
    }

    .column-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px 10px;
      border-bottom: 1px solid #334155;
    }

    .column-title-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
    }

    .column-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .column-title {
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #cbd5e1;
      cursor: pointer;
      border: none;
      background: transparent;
      color: #cbd5e1;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      outline: none;
      width: 100%;
    }

    .column-title:focus {
      background: #0f172a;
      border-radius: 4px;
      padding: 2px 6px;
    }

    .column-count {
      background: #334155;
      color: #94a3b8;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      min-width: 24px;
      text-align: center;
    }

    .column-actions {
      display: flex;
      gap: 4px;
    }

    .icon-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: #64748b;
      padding: 4px;
      border-radius: 6px;
      font-size: 1rem;
      line-height: 1;
      transition: all 0.15s;
    }
    .icon-btn:hover { background: #334155; color: #e2e8f0; }

    .cards-container {
      padding: 10px;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 60px;
    }

    /* Cards */
    .card {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 12px 14px;
      cursor: grab;
      transition: all 0.2s;
      position: relative;
    }

    .card:hover {
      border-color: #6366f1;
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(99,102,241,0.2);
    }

    .card.dragging {
      opacity: 0.4;
      cursor: grabbing;
    }

    .card-priority {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .priority-high   { background: #450a0a; color: #f87171; }
    .priority-medium { background: #431407; color: #fb923c; }
    .priority-low    { background: #052e16; color: #4ade80; }

    .card-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: #e2e8f0;
      margin-bottom: 6px;
      line-height: 1.4;
    }

    .card-desc {
      font-size: 0.78rem;
      color: #64748b;
      line-height: 1.5;
      margin-bottom: 8px;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
    }

    .card-tag {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 20px;
      font-weight: 600;
    }

    .card-due {
      font-size: 0.72rem;
      color: #64748b;
    }

    .card-due.overdue { color: #f87171; }

    .card-actions {
      position: absolute;
      top: 8px;
      right: 8px;
      display: none;
      gap: 4px;
    }

    .card:hover .card-actions { display: flex; }

    .card-action-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #94a3b8;
      border-radius: 5px;
      padding: 2px 6px;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.15s;
    }
    .card-action-btn:hover { background: #334155; color: #e2e8f0; }

    .add-card-btn {
      margin: 0 10px 10px;
      padding: 8px;
      background: none;
      border: 1px dashed #334155;
      border-radius: 8px;
      color: #64748b;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s;
      text-align: center;
    }
    .add-card-btn:hover { border-color: #6366f1; color: #a78bfa; background: #1a2540; }

    /* Add Column */
    .add-column-btn {
      min-width: 200px;
      height: 60px;
      background: #1e293b;
      border: 2px dashed #334155;
      border-radius: 14px;
      color: #64748b;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .add-column-btn:hover { border-color: #6366f1; color: #a78bfa; background: #1a2540; }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }
    .modal-overlay.active { display: flex; }

    .modal {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 28px;
      width: 420px;
      max-width: 95vw;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    .modal h2 {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: #e2e8f0;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 10px 12px;
      color: #e2e8f0;
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: #6366f1;
    }

    .form-group textarea { resize: vertical; min-height: 80px; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 20px;
    }

    /* Drag placeholder */
    .drag-placeholder {
      border: 2px dashed #6366f1;
      border-radius: 10px;
      height: 60px;
      background: rgba(99,102,241,0.05);
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    /* Tag colors */
    .tag-design   { background: #1e1b4b; color: #a5b4fc; }
    .tag-dev      { background: #0c1a2e; color: #38bdf8; }
    .tag-qa       { background: #1a0a2e; color: #c084fc; }
    .tag-research { background: #0a1f1a; color: #34d399; }
    .tag-ops      { background: #1c1000; color: #fbbf24; }
    .tag-other    { background: #1e293b; color: #94a3b8; }

    /* Stats bar */
    .stats-bar {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .stat {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stat-icon { font-size: 1.2rem; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-value { font-size: 1.1rem; font-weight: 700; color: #e2e8f0; }
    .stat-label { font-size: 0.72rem; color: #64748b; }

    /* Search */
    .search-input {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 8px 14px;
      color: #e2e8f0;
      font-size: 0.875rem;
      outline: none;
      width: 200px;
      transition: border-color 0.2s;
    }
    .search-input:focus { border-color: #6366f1; }
    .search-input::placeholder { color: #475569; }
  </style>
</head>
<body>

<header>
  <h1>🗂️ Kanban Board</h1>
  <div class="header-actions">
    <input class="search-input" type="text" id="searchInput" placeholder="🔍 Search cards…" oninput="filterCards()"/>
    <button class="btn btn-secondary" onclick="clearAll()">🗑 Clear All</button>
    <button class="btn btn-primary" onclick="openAddCard()">+ Add Card</button>
  </div>
</header>

<!-- Stats -->
<div class="stats-bar" id="statsBar"></div>

<!-- Board -->
<div class="board" id="board">
  <!-- Columns rendered by JS -->
  <button class="add-column-btn" onclick="addColumn()">＋ Add Column</button>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <h2 id="modalTitle">Add Card</h2>
    <div class="form-group">
      <label>Title *</label>
      <input type="text" id="cardTitle" placeholder="Card title…"/>
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea id="cardDesc" placeholder="Optional description…"></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Priority</label>
        <select id="cardPriority">
          <option value="low">🟢 Low</option>
          <option value="medium" selected>🟠 Medium</option>
          <option value="high">🔴 High</option>
        </select>
      </div>
      <div class="form-group">
        <label>Tag</label>
        <select id="cardTag">
          <option value="dev">Dev</option>
          <option value="design">Design</option>
          <option value="qa">QA</option>
          <option value="research">Research</option>
          <option value="ops">Ops</option>
          <option value="other">Other</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Due Date</label>
        <input type="date" id="cardDue"/>
      </div>
      <div class="form-group">
        <label>Column</label>
        <select id="cardColumn"></select>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveCard()">Save Card</button>
    </div>
  </div>
</div>

<script>
// ─── State ───────────────────────────────────────────────────────────────────
let state = {
  columns: [
    { id: 'col-1', title: 'To Do',       color: '#6366f1' },
    { id: 'col-2', title: 'In Progress', color: '#f59e0b' },
    { id: 'col-3', title: 'Review',      color: '#a78bfa' },
    { id: 'col-4', title: 'Done',        color: '#22c55e' },
  ],
  cards: [
    { id: 'c1', colId: 'col-1', title: 'Design new landing page',    desc: 'Revamp the hero section and CTA buttons.',  priority: 'high',   tag: 'design',   due: '2026-10-10' },
    { id: 'c2', colId: 'col-1', title: 'Set up CI/CD pipeline',      desc: 'Configure GitHub Actions for auto-deploy.', priority: 'medium', tag: 'dev',      due: '2026-10-15' },
    { id: 'c3', colId: 'col-2', title: 'Implement auth module',      desc: 'JWT-based login and refresh tokens.',        priority: 'high',   tag: 'dev',      due: '2026-10-05' },
    { id: 'c4', colId: 'col-2', title: 'Write unit tests',           desc: 'Cover core business logic with Jest.',       priority: 'medium', tag: 'qa',       due: '2026-10-12' },
    { id: 'c5', colId: 'col-3', title: 'API documentation',          desc: 'Document all REST endpoints in Swagger.',    priority: 'low',    tag: 'dev',      due: '2026-10-20' },
    { id: 'c6', colId: 'col-4', title: 'User research interviews',   desc: 'Completed 8 user interviews.',               priority: 'low',    tag: 'research', due: '2026-09-28' },
  ]
};

let editingCardId = null;
let dragCardId    = null;
let dragColId     = null;

// ─── Persistence ─────────────────────────────────────────────────────────────
function save() {
  try { localStorage.setItem('kanban_state', JSON.stringify(state)); } catch(e) {}
}
function load() {
  try {
    const s = localStorage.getItem('kanban_state');
    if (s) state = JSON.parse(s);
  } catch(e) {}
}

// ─── Render ───────────────────────────────────────────────────────────────────
function render() {
  save();
  renderStats();
  renderBoard();
}

function renderStats() {
  const total = state.cards.length;
  const done  = state.cards.filter(c => {
    const col = state.columns.find(col => col.id === c.colId);
    return col && col.title.toLowerCase() === 'done';
  }).length;
  const high  = state.cards.filter(c => c.priority === 'high').length;
  const today = new Date().toISOString().split('T')[0];
  const overdue = state.cards.filter(c => c.due && c.due < today && !state.columns.find(col => col.id === c.colId && col.title.toLowerCase() === 'done')).length;

  document.getElementById('statsBar').innerHTML = `
    <div class="stat"><span class="stat-icon">📋</span><div class="stat-info"><span class="stat-value">${total}</span><span class="stat-label">Total Cards</span></div></div>
    <div class="stat"><span class="stat-icon">✅</span><div class="stat-info"><span class="stat-value">${done}</span><span class="stat-label">Completed</span></div></div>
    <div class="stat"><span class="stat-icon">🔴</span><div class="stat-info"><span class="stat-value">${high}</span><span class="stat-label">High Priority</span></div></div>
    <div class="stat"><span class="stat-icon">⏰</span><div class="stat-info"><span class="stat-value">${overdue}</span><span class="stat-label">Overdue</span></div></div>
  `;
}

function renderBoard() {
  const board = document.getElementById('board');
  const addBtn = board.querySelector('.add-column-btn');
  // Remove old columns
  board.querySelectorAll('.column').forEach(el => el.remove());

  const query = document.getElementById('searchInput').value.toLowerCase();

  state.columns.forEach(col => {
    const cards = state.cards.filter(c => {
      if (c.colId !== col.id) return false;
      if (!query) return true;
      return c.title.toLowerCase().includes(query) || (c.desc||'').toLowerCase().includes(query);
    });

    const colEl = document.createElement('div');
    colEl.className = 'column';
    colEl.dataset.colId = col.id;

    colEl.innerHTML = `
      <div class="column-header">
        <div class="column-title-wrap">
          <div class="column-dot" style="background:${col.color}"></div>
          <input class="column-title" value="${escHtml(col.title)}" onblur="renameColumn('${col.id}', this.value)" onkeydown="if(event.key==='Enter')this.blur()"/>
        </div>
        <span class="column-count">${cards.length}</span>
        <div class="column-actions">
          <button class="icon-btn" title="Delete column" onclick="deleteColumn('${col.id}')">🗑</button>
        </div>
      </div>
      <div class="cards-container" id="cards-${col.id}"
           ondragover="onDragOver(event,'${col.id}')"
           ondragleave="onDragLeave(event,'${col.id}')"
           ondrop="onDrop(event,'${col.id}')">
        ${cards.map(c => cardHTML(c)).join('')}
      </div>
      <button class="add-card-btn" onclick="openAddCard('${col.id}')">＋ Add card</button>
    `;

    board.insertBefore(colEl, addBtn);
  });

  // Attach drag events to cards
  document.querySelectorAll('.card').forEach(el => {
    el.addEventListener('dragstart', e => onDragStart(e, el.dataset.cardId));
    el.addEventListener('dragend',   e => onDragEnd(e, el.dataset.cardId));
  });
}

function cardHTML(c) {
  const today = new Date().toISOString().split('T')[0];
  const overdue = c.due && c.due < today;
  const dueLabel = c.due ? formatDate(c.due) : '';
  return `
    <div class="card" draggable="true" data-card-id="${c.id}">
      <div class="card-actions">
        <button class="card-action-btn" onclick="openEditCard('${c.id}')">✏️</button>
        <button class="card-action-btn" onclick="deleteCard('${c.id}')">🗑</button>
      </div>
      <span class="card-priority priority-${c.priority}">${c.priority}</span>
      <div class="card-title">${escHtml(c.title)}</div>
      ${c.desc ? `<div class="card-desc">${escHtml(c.desc)}</div>` : ''}
      <div class="card-footer">
        <span class="card-tag tag-${c.tag}">${c.tag}</span>
        ${dueLabel ? `<span class="card-due ${overdue?'overdue':''}">${overdue?'⚠️ ':'📅 '}${dueLabel}</span>` : ''}
      </div>
    </div>
  `;
}

// ─── Drag & Drop ─────────────────────────────────────────────────────────────
function onDragStart(e, cardId) {
  dragCardId = cardId;
  setTimeout(() => {
    const el = document.querySelector(`[data-card-id="${cardId}"]`);
    if (el) el.classList.add('dragging');
  }, 0);
}

function onDragEnd(e, cardId) {
  dragCardId = null;
  document.querySelectorAll('.card').forEach(el => el.classList.remove('dragging'));
  document.querySelectorAll('.drag-placeholder').forEach(el => el.remove());
  document.querySelectorAll('.column').forEach(el => el.classList.remove('drag-over'));
}

function onDragOver(e, colId) {
  e.preventDefault();
  const col = document.querySelector(`[data-col-id="${colId}"]`);
  if (col) col.classList.add('drag-over');
}

function onDragLeave(e, colId) {
  const col = document.querySelector(`[data-col-id="${colId}"]`);
  if (col) col.classList.remove('drag-over');
}

function onDrop(e, colId) {
  e.preventDefault();
  if (!dragCardId) return;
  const card = state.cards.find(c => c.id === dragCardId);
  if (card) card.colId = colId;
  render();
}

// ─── Modal ────────────────────────────────────────────────────────────────────
function openAddCard(colId) {
  editingCardId = null;
  document.getElementById('modalTitle').textContent = 'Add Card';
  document.getElementById('cardTitle').value = '';
  document.getElementById('cardDesc').value  = '';
  document.getElementById('cardPriority').value = 'medium';
  document.getElementById('cardTag').value   = 'dev';
  document.getElementById('cardDue').value   = '';
  populateColumnSelect(colId || state.columns[0]?.id);
  document.getElementById('modalOverlay').classList.add('active');
  document.getElementById('cardTitle').focus();
}

function openEditCard(cardId) {
  const c = state.cards.find(c => c.id === cardId);
  if (!c) return;
  editingCardId = cardId;
  document.getElementById('modalTitle').textContent = 'Edit Card';
  document.getElementById('cardTitle').value    = c.title;
  document.getElementById('cardDesc').value     = c.desc || '';
  document.getElementById('cardPriority').value = c.priority;
  document.getElementById('cardTag').value      = c.tag;
  document.getElementById('cardDue').value      = c.due || '';
  populateColumnSelect(c.colId);
  document.getElementById('modalOverlay').classList.add('active');
}

function populateColumnSelect(selectedId) {
  const sel = document.getElementById('cardColumn');
  sel.innerHTML = state.columns.map(col =>
    `<option value="${col.id}" ${col.id === selectedId ? 'selected' : ''}>${escHtml(col.title)}</option>`
  ).join('');
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('active');
  editingCardId = null;
}

function saveCard() {
  const title = document.getElementById('cardTitle').value.trim();
  if (!title) { document.getElementById('cardTitle').focus(); return; }

  const data = {
    title,
    desc:     document.getElementById('cardDesc').value.trim(),
    priority: document.getElementById('cardPriority').value,
    tag:      document.getElementById('cardTag').value,
    due:      document.getElementById('cardDue').value,
    colId:    document.getElementById('cardColumn').value,
  };

  if (editingCardId) {
    const idx = state.cards.findIndex(c => c.id === editingCardId);
    if (idx !== -1) state.cards[idx] = { ...state.cards[idx], ...data };
  } else {
    state.cards.push({ id: 'c' + Date.now(), ...data });
  }

  closeModal();
  render();
}

// ─── Column Actions ───────────────────────────────────────────────────────────
function addColumn() {
  const colors = ['#6366f1','#f59e0b','#a78bfa','#22c55e','#ef4444','#38bdf8','#f472b6'];
  const color  = colors[state.columns.length % colors.length];
  state.columns.push({ id: 'col-' + Date.now(), title: 'New Column', color });
  render();
}

function renameColumn(colId, newTitle) {
  const col = state.columns.find(c => c.id === colId);
  if (col && newTitle.trim()) col.title = newTitle.trim();
  render();
}

function deleteColumn(colId) {
  if (!confirm('Delete this column and all its cards?')) return;
  state.columns = state.columns.filter(c => c.id !== colId);
  state.cards   = state.cards.filter(c => c.colId !== colId);
  render();
}

// ─── Card Actions ─────────────────────────────────────────────────────────────
function deleteCard(cardId) {
  state.cards = state.cards.filter(c => c.id !== cardId);
  render();
}

function clearAll() {
  if (!confirm('Clear all cards from the board?')) return;
  state.cards = [];
  render();
}

// ─── Search ───────────────────────────────────────────────────────────────────
